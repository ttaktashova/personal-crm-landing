---
// Cat peeking over the phone (design/assets/cat-peek.svg).
// Place it so that y=96 of the viewBox sits on the phone's top edge: the paws overlap the bezel.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 160 104"
  class={className}
  role="img"
  aria-label="Черный кот выглядывает из-за телефона и читает список"
>
  <path
    d="M26 66 L32 12 Q33 5 40 9 L64 34 Z"
    class="fill-cat stroke-cat"
    stroke-width="4"
    stroke-linejoin="round"></path>
  <path
    d="M134 66 L128 12 Q127 5 120 9 L96 34 Z"
    class="fill-cat stroke-cat"
    stroke-width="4"
    stroke-linejoin="round"></path>
  <path d="M20 97 C18 56 44 30 80 30 C116 30 142 56 140 97 Z" class="fill-cat"></path>
  <path d="M34 52 L37 22 L54 38 Z" class="fill-cat-pink"></path>
  <path d="M126 52 L123 22 L106 38 Z" class="fill-cat-pink"></path>
  <circle cx="60" cy="64" r="12" class="fill-cat-eye"></circle>
  <circle cx="100" cy="64" r="12" class="fill-cat-eye"></circle>
  <circle cx="62" cy="69" r="6" class="fill-cat"></circle>
  <circle cx="102" cy="69" r="6" class="fill-cat"></circle>
  <circle cx="64" cy="66.5" r="2.2" class="fill-cat-glint"></circle>
  <circle cx="104" cy="66.5" r="2.2" class="fill-cat-glint"></circle>
  <path
    d="M76 80 L84 80 L80 84.5 Z"
    class="fill-cat-pink stroke-cat-pink"
    stroke-width="2"
    stroke-linejoin="round"></path>
  <path
    d="M73 88 Q76.5 91.5 80 88 Q83.5 91.5 87 88"
    fill="none"
    class="stroke-cat-pink"
    stroke-width="2"
    stroke-linecap="round"></path>
  <g class="stroke-cream" stroke-width="1.8" stroke-linecap="round" opacity="0.7">
    <path d="M30 80 L4 76"></path>
    <path d="M30 86 L6 90"></path>
    <path d="M130 80 L156 76"></path>
    <path d="M130 86 L154 90"></path>
  </g>
  <ellipse cx="48" cy="97" rx="16" ry="8" class="fill-cat"></ellipse>
  <ellipse cx="112" cy="97" rx="16" ry="8" class="fill-cat"></ellipse>
</svg>
