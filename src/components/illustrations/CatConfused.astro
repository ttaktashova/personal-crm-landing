---
// Confused cat head with two question marks (design/assets/cat-confused.svg). Decorative.
// Kept inline so the "?" glyphs use the page's display font.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 130 92" class={className} aria-hidden="true">
  <g transform="translate(20 4) scale(0.42)">
    <path
      d="M58 100 L66 22 Q68 12 78 18 L120 56 Z"
      class="fill-cat stroke-border"
      stroke-width="4"
      stroke-linejoin="round"></path>
    <path
      d="M242 100 L234 22 Q232 12 222 18 L180 56 Z"
      class="fill-cat stroke-border"
      stroke-width="4"
      stroke-linejoin="round"></path>
    <path
      d="M50 120 C50 72 92 52 150 52 C208 52 250 72 250 120 C250 172 208 196 150 196 C92 196 50 172 50 120 Z"
      class="fill-cat stroke-border"
      stroke-width="4"></path>
    <path d="M72 80 L76 38 L102 60 Z" class="fill-cat-pink"></path>
    <path d="M228 80 L224 38 L198 60 Z" class="fill-cat-pink"></path>
    <circle cx="112" cy="122" r="25" class="fill-cat-eye"></circle>
    <circle cx="188" cy="122" r="25" class="fill-cat-eye"></circle>
    <circle cx="102" cy="112" r="12" class="fill-cat"></circle>
    <circle cx="178" cy="112" r="12" class="fill-cat"></circle>
    <circle cx="106" cy="107" r="4.5" class="fill-cat-glint"></circle>
    <circle cx="182" cy="107" r="4.5" class="fill-cat-glint"></circle>
    <path
      d="M143 150 L157 150 L150 157 Z"
      class="fill-cat-pink stroke-cat-pink"
      stroke-width="3"
      stroke-linejoin="round"></path>
    <path
      d="M134 170 Q142 162 150 170 Q158 178 166 170"
      fill="none"
      class="stroke-cat-pink"
      stroke-width="3.5"
      stroke-linecap="round"></path>
  </g>
  <text x="4" y="40" font-size="28" class="fill-accent font-display" transform="rotate(-12 12 30)">?</text>
  <text x="24" y="20" font-size="18" class="fill-accent font-display" transform="rotate(10 30 14)">?</text>
</svg>
