---
// Brand mark: accent tile with an ink cat head (design/assets/logo.svg).
// Small copies in the footer and the notification have no eyes, as in the mockup.
interface Props {
  class?: string;
  eyes?: boolean;
}

const { class: className, eyes = true } = Astro.props;
---

<svg viewBox="0 0 32 32" class:list={["flex-none", className]} aria-hidden="true">
  <rect width="32" height="32" rx="9" class="fill-accent" />
  <path
    d="M8 25 L8 9 L12.5 13 L19.5 13 L24 9 L24 25 Z"
    class="fill-ink stroke-ink"
    stroke-width="2.5"
    stroke-linejoin="round"
  />
  {
    eyes && (
      <>
        <circle cx="13" cy="19" r="1.6" class="fill-accent" />
        <circle cx="19" cy="19" r="1.6" class="fill-accent" />
      </>
    )
  }
</svg>
